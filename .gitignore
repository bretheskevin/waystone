/target
**/*.rs.bk
.DS_Store
*.swp
.env
.idea/

# Serena MCP tooling
.serena/
# Local corporate CA certs for the Docker build (not committed)
switch/certs/*.pem
switch/certs/*.crt

# Switch homebrew build artifacts
switch/build/
switch/*.nro
switch/*.elf
switch/*.nacp
switch/*.map
switch/build.log

# Switch romfs is assembled at build time from the borealis submodule;
# only cacert.pem is committed.
switch/romfs/*
!switch/romfs/cacert.pem

# Generated knowledge-graph cache
graphify-out/
