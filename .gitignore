/target
**/*.rs.bk
.DS_Store
*.swp
.env
.idea/

# Serena MCP tooling
.serena/
# Local corporate CA certs for the Docker build (not committed)
switch/certs/*.pem
switch/certs/*.crt
3ds/certs/*.pem
3ds/certs/*.crt

# Switch homebrew build artifacts
switch/build/
switch/*.nro
switch/*.elf
switch/*.nacp
switch/*.map
switch/build.log

# Switch romfs is assembled at build time from the borealis submodule;
# only cacert.pem is committed.
switch/romfs/*
!switch/romfs/cacert.pem

# 3DS homebrew build artifacts
3ds/build/
3ds/*.3dsx
3ds/*.elf
3ds/*.smdh
3ds/*.map
3ds/*.cia
3ds/app.bnr
3ds/build.log

# Generated knowledge-graph cache
graphify-out/

# Android shell build artifacts
android/.gradle/
android/.kotlin/
android/**/build/
android/local.properties
android/engine/src/main/jniLibs/
